# Zerodha Kite Connect API Credentials
# Sign up at: https://kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=generate_after_login_redirect

# Database Configuration
DATABASE_URL=sqlite:///./leanflow.db

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LEAN Engine Configuration
LEAN_DATA_FOLDER=./data
LEAN_RESULTS_FOLDER=./results
LEAN_CONFIG_PATH=./src/config/config.json

# Redis (for task queue - optional for MVP)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Risk Management (SEBI Compliance)
MAX_OPS_PER_SECOND=10
DRAWDOWN_KILL_SWITCH_THRESHOLD=0.05
ENABLE_KILL_SWITCH=true

# Environment
ENVIRONMENT=development
DEBUG=true

